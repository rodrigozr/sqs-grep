{
  "name": "sqs-grep",
  "version": "2.0.0",
  "type": "module",
  "description": "Greps AWS SQS messages from the command-line, optionally moving or deleting them",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sqs-grep": "dist/main.js"
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "readme.md",
    "user-scripts.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "clean": "rm -rf dist build coverage",
    "lint": "oxlint src test",
    "test": "npm run lint && npm run build:test && c8 mocha",
    "test:watch": "mocha --require tsx --spec 'test/**/*.test.ts' --watch --watch-files src,test",
    "integration-test": "RUN_INTEGRATION_TESTS=1 npm test",
    "prepack": "npm run clean && npm run build",
    "snyk-ci": "snyk test && snyk monitor",
    "snyk-test": "snyk test",
    "snyk-monitor": "snyk monitor"
  },
  "mocha": {
    "spec": "build/test/**/*.test.js"
  },
  "c8": {
    "all": true,
    "src": "src",
    "include": [
      "build/src/**/*.js"
    ],
    "exclude": [
      "build/src/main.js"
    ],
    "reporter": [
      "text",
      "lcov"
    ],
    "check-coverage": true,
    "statements": 100,
    "branches": 100,
    "functions": 100,
    "lines": 100
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrigozr/sqs-grep.git"
  },
  "homepage": "https://github.com/rodrigozr/sqs-grep",
  "keywords": [
    "aws",
    "sqs",
    "grep",
    "cli",
    "commandline"
  ],
  "author": "Rodrigo Rosauro",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1132.0",
    "@aws-sdk/client-sqs": "^3.1132.0",
    "bottleneck": "^2.19.5",
    "chalk": "^6.0.0",
    "command-line-args": "^6.0.2",
    "command-line-usage": "^7.0.4",
    "n-readlines": "^3.4.1",
    "node-gzip": "^1.1.2",
    "password-prompt": "^1.1.3"
  },
  "devDependencies": {
    "@types/command-line-args": "^5.2.3",
    "@types/command-line-usage": "^5.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.2",
    "@types/sinon": "^22.0.0",
    "c8": "^12.0.0",
    "coveralls": "^3.1.1",
    "mocha": "^12.0.1",
    "mocha-lcov-reporter": "^1.3.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "sinon": "^22.1.0",
    "snyk": "^1.1307.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
